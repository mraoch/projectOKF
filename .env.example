# PostgreSQL admin connection (used by scripts/ingest_data.py)
PG_HOST=localhost
PG_PORT=5432
PG_DB=aai_food
PG_USER=postgres
PG_PASSWORD=postgres

# Read-only role the AI agent connects with (created by ingest_data.py)
PG_READER_PASSWORD=ro_postgres

# Groq (LLM)
GROQ_API_KEY=gsk_....
LLM_MODEL=openai/gpt-oss-120b
